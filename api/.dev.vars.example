# Copy this file to ".dev.vars" and fill in real values.
# ".dev.vars" is git-ignored. This example file is safe to commit.
# Find these in Supabase: Project Settings -> API Keys / Data API.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Comma-separated Supabase user IDs allowed to use admin routes.
# Find yours in Supabase: Authentication -> Users -> UID.
ADMIN_USER_IDS=00000000-0000-0000-0000-000000000000

# Optional: comma-separated browser origins allowed by CORS (defaults to http://localhost:5173,http://127.0.0.1:5173).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173


{
  // Cloudflare Worker configuration for the NEXUS API.
  "name": "nexus-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "nexus-media"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
